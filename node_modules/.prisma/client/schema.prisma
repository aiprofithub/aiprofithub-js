// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  MISTRAL
  GROQ
  COHERE
  HUGGINGFACE
  CUSTOM
}

enum AlertType {
  BUDGET_THRESHOLD
  SPIKE_DETECTION
  MODEL_COST
  DAILY_LIMIT
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  RESOLVED
  DISABLED
}

enum AlertChannel {
  EMAIL
  SLACK
  WEBHOOK
}

enum CostPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  ABORTED
}

enum ExecutionLocale {
  TH_TH @map("th-TH")
  EN_US @map("en-US")
}

enum ChurnSignalType {
  NO_ACTIVITY
  USAGE_DECLINE
  DOWNGRADE
  SINGLE_USER
  TRIAL_EXPIRING
}

enum LeadSource {
  MANUAL
  WEBSITE
  REFERRAL
  OUTBOUND
  INTEGRATION
}

enum LeadStage {
  NEW
  ENRICHED
  QUALIFIED
  CONTACTED
  MEETING_BOOKED
  PILOT
  WON
  LOST
}

enum LeadTier {
  A
  B
  C
}

enum AuditRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AuditPeriodKey {
  LAST_7_DAYS
  LAST_30_DAYS
}

enum AuditFindingType {
  MODEL_OVERKILL
  LONG_CONTEXT
  RETRY_WASTE
  OVER_FREQUENCY
  NO_CACHING
}

enum AuditEffort {
  LOW
  MEDIUM
  HIGH
}

enum ExternalEffectStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  POISONED
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
  POISONED
}

enum ProcessingStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// ─── User ──────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members           Member[]
  usageRecords      UsageRecord[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  partner           Partner?
  referral          Referral?
  engineeringWallet EngineeringWallet?
  engineeringDebts  EngineeringDebt[]

  @@index([clerkId])
  @@index([email])
  @@map("users")
}

// ─── Organization ──────────────────────────────────────────────────────────────

model Organization {
  id                    String    @id @default(cuid())
  clerkOrgId            String?   @unique
  name                  String
  slug                  String    @unique
  preferredLocale       String?
  logoUrl               String?
  plan                  PlanType  @default(FREE)
  monthlyBudget         Float?
  currency              String    @default("USD")
  timezone              String    @default("UTC")
  // Stripe
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  stripeMeterId         String?
  currentPeriodEnd      DateTime?
  trialEndsAt           DateTime?
  onboardingDismissedAt DateTime?
  suspendedAt           DateTime?
  suspendedReason       String?
  weeklyDigestEnabled   Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  members              Member[]
  aiModels             AIModel[]
  usageRecords         UsageRecord[]
  costRecords          CostRecord[]
  alerts               Alert[]
  apiKeys              ApiKey[]
  invoices             Invoice[]
  workflowRuns         WorkflowRun[]
  agentRuns            AgentRun[]
  churnSignals         ChurnSignal[]
  leads                Lead[]
  leadActivities       LeadActivity[]
  leadDemoPreferences  LeadDemoPreference[]
  auditResults         AuditResult[]
  auditRuns            AuditRun[]
  auditFindings        AuditFinding[]
  auditRecommendations AuditRecommendation[]
  auditLogs            AuditLog[]
  agentApprovals       AgentRecommendationApproval[]
  agentRecommendations AgentRecommendation[]
  demoBookings         DemoBooking[]
  demoRecipients       DemoRecipient[]               @relation("DemoRecipientsOrg")
  entitlement          OrgEntitlement?
  externalEffects      ExternalEffect[]
  outboxEvents         OutboxEvent[]
  deals                Deal[]
  outreachLogs         OutreachLog[]
  proposals            Proposal[]
  evolutionMutations   EvolutionMutation[]
  campaigns            Campaign[]
  systemEvents         SystemEvent[]
  worldSnapshot        WorldSnapshot?

  @@index([slug])
  @@index([clerkOrgId])
  @@index([plan])
  @@map("organizations")
}

// ─── Member ────────────────────────────────────────────────────────────────────

model Member {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole @default(MEMBER)
  joinedAt       DateTime @default(now())

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("members")
}

// ─── AI Model ──────────────────────────────────────────────────────────────────

model AIModel {
  id              String     @id @default(cuid())
  organizationId  String
  provider        AIProvider
  modelId         String
  displayName     String
  description     String?
  inputCostPer1k  Float      @default(0)
  outputCostPer1k Float      @default(0)
  currency        String     @default("USD")
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]
  costRecords  CostRecord[]
  alerts       Alert[]

  @@unique([organizationId, provider, modelId])
  @@index([organizationId])
  @@index([provider])
  @@map("ai_models")
}

// ─── Usage Record ──────────────────────────────────────────────────────────────

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  modelId        String
  userId         String?
  requestId      String?  @unique
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  latencyMs      Int?
  statusCode     Int?
  errorMessage   String?
  metadata       Json?
  timestamp      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  model        AIModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([modelId])
  @@index([userId])
  @@index([timestamp])
  @@index([organizationId, timestamp])
  @@map("usage_records")
}

// ─── Cost Record ───────────────────────────────────────────────────────────────

model CostRecord {
  id             String     @id @default(cuid())
  organizationId String
  modelId        String?
  period         CostPeriod
  periodStart    DateTime
  periodEnd      DateTime
  totalCost      Float      @default(0)
  inputCost      Float      @default(0)
  outputCost     Float      @default(0)
  totalTokens    Int        @default(0)
  inputTokens    Int        @default(0)
  outputTokens   Int        @default(0)
  requestCount   Int        @default(0)
  currency       String     @default("USD")
  createdAt      DateTime   @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  model        AIModel?     @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@unique([organizationId, modelId, period, periodStart])
  @@index([organizationId])
  @@index([organizationId, period, periodStart])
  @@index([periodStart, periodEnd])
  @@index([organizationId, createdAt]) // triage: runbooks/trace-triage-incident-guide.md
  @@map("cost_records")
}

// ─── Alert ─────────────────────────────────────────────────────────────────────

model Alert {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  type            AlertType
  status          AlertStatus    @default(ACTIVE)
  threshold       Float
  currency        String         @default("USD")
  channels        AlertChannel[]
  channelConfig   Json?
  modelId         String?
  lastTriggeredAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  model        AIModel?     @relation(fields: [modelId], references: [id], onDelete: SetNull)
  events       AlertEvent[]

  @@index([organizationId])
  @@index([status])
  @@map("alerts")
}

// ─── Alert Event ───────────────────────────────────────────────────────────────

model AlertEvent {
  id          String    @id @default(cuid())
  alertId     String
  triggeredAt DateTime  @default(now())
  value       Float
  message     String
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?

  // Relations
  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@map("alert_events")
}

// ─── API Key ───────────────────────────────────────────────────────────────────

model ApiKey {
  id              String    @id @default(cuid())
  organizationId  String
  createdByUserId String
  name            String
  keyPrefix       String
  keyHash         String    @unique
  scopes          String[]
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

// ─── Invoice ───────────────────────────────────────────────────────────────────

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  stripeInvoiceId String?       @unique
  amount          Float
  currency        String        @default("USD")
  status          InvoiceStatus @default(DRAFT)
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  paidEmailSentAt DateTime?
  dueDate         DateTime?
  invoiceUrl      String?
  createdAt       DateTime      @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([stripeInvoiceId])
  @@map("invoices")
}

// ─── Workflow Run ─────────────────────────────────────────────────────────────
// Replaces the raw SQL agent_silent_churn_runs table.

model WorkflowRun {
  id                     String         @id @default(cuid())
  organizationId         String?
  type                   String // e.g. "silent-churn", "weekly-digest", "cost-aggregation"
  status                 WorkflowStatus @default(PENDING)
  input                  Json?
  output                 Json?
  error                  String?
  durationMs             Int?
  recoveryAttempts       Int            @default(0)
  lastHeartbeatAt        DateTime?
  recoveryLeaseId        String?
  recoveryLeaseExpiresAt DateTime?
  statusReason           String?
  startedAt              DateTime       @default(now())
  completedAt            DateTime?

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type, status])
  @@index([startedAt])
  @@index([status, lastHeartbeatAt])
  @@map("workflow_runs")
}

// ─── Agent Run ────────────────────────────────────────────────────────────────
// Records every AI agent execution with step-level detail and cost.

model AgentRun {
  id                     String          @id @default(cuid())
  organizationId         String?
  agentType              String // "cost-anomaly" | "budget-forecast" | etc.
  executionLocale        ExecutionLocale @default(EN_US) // Canonical execution locale: th-TH | en-US
  localePolicyVersion    String?
  localeResolutionSource String?
  modelUsed              String?
  reasoningDepth         String?
  toolAggressiveness     String?
  toolCallCount          Int             @default(0)
  qualityProxyScore      Float?
  localeFitScore         Float?
  status                 AgentRunStatus  @default(RUNNING)
  steps                  Json            @default("[]") // Array of step objects
  inputTokens            Int             @default(0)
  outputTokens           Int             @default(0)
  costUsd                Float           @default(0)
  runBudgetUsd           Float?
  maxStepCount           Int?
  retryCount             Int             @default(0)
  recoveryAttempts       Int             @default(0)
  lastHeartbeatAt        DateTime?
  recoveryLeaseId        String?
  recoveryLeaseExpiresAt DateTime?
  statusReason           String?
  error                  String?
  durationMs             Int?
  startedAt              DateTime        @default(now())
  completedAt            DateTime?

  // Relations
  organization    Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  recommendations AgentRecommendation[]
  stepTraces      AgentRunStep[]

  @@index([organizationId])
  @@index([agentType])
  @@index([executionLocale])
  @@index([status])
  @@index([startedAt])
  @@index([status, lastHeartbeatAt])
  @@map("agent_runs")
}

model LocalePolicy {
  id              String          @id @default(cuid())
  locale          ExecutionLocale
  version         String
  isActive        Boolean         @default(false)
  promptTemplate  String?
  constraintsJson Json?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([locale, version])
  @@index([locale, isActive])
  @@map("locale_policies")
}

model AgentRunStep {
  id                String    @id @default(cuid())
  agentRunId        String
  stepNumber        Int
  finishReason      String?
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  costUsd           Float     @default(0)
  cumulativeCostUsd Float     @default(0)
  projectedRoiUsd   Float?
  projectedRoiRatio Float?
  toolCallCount     Int       @default(0)
  toolResultCount   Int       @default(0)
  metadata          Json?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  isFinal           Boolean   @default(false)

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, stepNumber])
  @@index([agentRunId])
  @@index([isFinal])
  @@index([startedAt])
  @@map("agent_run_steps")
}

// ─── Agent Recommendation ───────────────────────────────────────────────────
// Durable recommendation items emitted by agent runs.

model AgentRecommendation {
  id               String   @id @default(cuid())
  organizationId   String
  agentRunId       String?
  requestId        String
  recommendationId String
  sourceAgentType  String?
  agentType        String
  summary          String
  action           String
  expectedImpact   String
  confidence       Float
  assumptions      String[] @default([])
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@unique([organizationId, requestId, recommendationId], name: "org_request_recommendation_item_unique")
  @@index([organizationId])
  @@index([agentRunId])
  @@index([requestId])
  @@index([recommendationId])
  @@index([sourceAgentType])
  @@index([agentType])
  @@index([requiresApproval])
  @@index([createdAt])
  @@map("agent_recommendations")
}

// ─── Churn Signal ─────────────────────────────────────────────────────────────
// Risk scores generated by ChurnPredictionAgent.

model ChurnSignal {
  id                    String          @id @default(cuid())
  organizationId        String
  signalType            ChurnSignalType
  score                 Float // 0.0 = safe, 1.0 = critical
  daysSinceLastActivity Int
  metadata              Json?
  detectedAt            DateTime        @default(now())
  actedOn               Boolean         @default(false)
  actedAt               DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([score])
  @@index([detectedAt])
  @@index([actedOn])
  @@map("churn_signals")
}

// ─── Lead ─────────────────────────────────────────────────────────────────────
// Prospect records used for GTM pipeline and AI-assisted qualification.

model Lead {
  id                   String     @id @default(cuid())
  organizationId       String
  companyName          String
  website              String?
  domain               String?
  contactName          String?
  contactEmail         String?
  linkedInUrl          String?
  title                String? // Job title for readiness assessment
  timezone             String? // For demo slot scheduling
  isPrimaryContact     Boolean    @default(false)
  engagementScore      Int? // 0-100 engagement level
  source               LeadSource @default(MANUAL)
  stage                LeadStage  @default(NEW)
  tier                 LeadTier?
  score                Int?
  scoreReason          String?
  nextAction           String?
  estAiSpendUsdMonthly Float?
  employeeCount        Int?
  useCaseHint          String?
  techStack            Json?
  lastContactedAt      DateTime?
  followUpAt           DateTime?
  notes                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Relations
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities      LeadActivity[]
  auditResults    AuditResult[]
  demoBookings    DemoBooking[]
  demoPreferences LeadDemoPreference[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, tier])
  @@index([organizationId, score])
  @@index([organizationId, engagementScore])
  @@index([organizationId, isPrimaryContact])
  @@index([organizationId, createdAt])
  @@map("leads")
}

// ─── Lead Activity ────────────────────────────────────────────────────────────
// Timeline events for acquisition and follow-up execution.

model LeadActivity {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  activityType   String
  note           String?
  metadata       Json?
  createdAt      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([activityType])
  @@index([createdAt])
  @@map("lead_activities")
}

model AuditLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  company      String
  role         String
  monthlySpend Int
  providers    String[]
  painPoint    String

  locale            String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  referrer          String?
  landingPath       String?
  experimentVariant String?
  entrypoint        String?

  companySize    String?
  biggestProblem String?

  packageCode             String?
  paymentStatus           String    @default("pending")
  stripeCheckoutSessionId String?   @unique
  stripeCustomerId        String?
  stripePaymentIntentId   String?
  amountPaidCents         Int?
  currency                String?
  paidAt                  DateTime?

  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploads AuditUpload[]
  report  AuditReport?

  @@index([email])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

enum AuditReportStatus {
  DRAFT
  READY
  PUBLISHED
  DELIVERED
  ARCHIVED
}

enum AuditUploadStatus {
  RECEIVED
  STORAGE_PENDING
  STORED
  PROCESSING
  PROCESSED
  FAILED
}

model AuditUpload {
  id             String            @id @default(cuid())
  auditLeadId    String
  fileName       String
  contentType    String
  sizeBytes      Int
  storageKey     String?
  checksumSha256 String?
  status         AuditUploadStatus @default(RECEIVED)
  errorMessage   String?
  metadata       Json?
  receivedAt     DateTime          @default(now())
  storedAt       DateTime?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  auditLead AuditLead @relation(fields: [auditLeadId], references: [id], onDelete: Cascade)

  @@index([auditLeadId])
  @@index([status])
  @@index([receivedAt])
  @@index([storageKey])
  @@map("audit_uploads")
}

// ─── Audit Result ─────────────────────────────────────────────────────────────
// Public audit submissions used for the savings-plan funnel.

model AuditReport {
  id          String            @id @default(cuid())
  auditLeadId String            @unique
  status      AuditReportStatus @default(DRAFT)

  title                 String
  executiveSummary      String
  keyFindings           Json   @default("[]")
  recommendations       Json   @default("[]")
  estimatedSavingsCents Int?
  currency              String @default("USD")
  reportVersion         Int    @default(1)

  publishedAt     DateTime?
  deliveredAt     DateTime?
  lastEmailSentAt DateTime?
  pdfUrl          String?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLead   AuditLead               @relation(fields: [auditLeadId], references: [id], onDelete: Cascade)
  emailEvents AuditReportEmailEvent[]

  @@index([status])
  @@index([publishedAt])
  @@index([deliveredAt])
  @@index([createdAt])
  @@map("audit_reports")
}

model AuditReportEmailEvent {
  id              String    @id @default(cuid())
  auditReportId   String
  auditLeadId     String
  eventType       String
  recipientEmail  String
  resendMessageId String?
  status          String    @default("sent")
  errorMessage    String?
  metadata        Json      @default("{}")
  sentAt          DateTime  @default(now())
  openedAt        DateTime?
  clickedAt       DateTime?

  auditReport AuditReport @relation(fields: [auditReportId], references: [id], onDelete: Cascade)

  @@index([auditReportId])
  @@index([auditLeadId])
  @@index([eventType])
  @@index([sentAt])
  @@map("audit_report_email_events")
}

model AuditResult {
  id                       String    @id @default(cuid())
  organizationId           String?
  leadId                   String?
  email                    String
  companyName              String
  industry                 String?
  teamSize                 Int?
  monthlySpendUsd          Float
  provider                 String
  requestVolume            String?
  useCaseHint              String?
  estimatedWasteUsdMonthly Float
  estimatedWasteUsdYearly  Float
  wastePercent             Int
  breakdown                Json
  recommendations          Json
  rationale                Json?
  score                    Int?
  leadTier                 LeadTier?
  nextAction               String?
  stripeCheckoutSessionId  String?   @unique
  unlockedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  demoBookings DemoBooking[]

  @@index([organizationId])
  @@index([leadId])
  @@index([email])
  @@index([createdAt])
  @@index([unlockedAt])
  @@map("audit_results")
}

// ─── Internal Audit Run ─────────────────────────────────────────────────────
// Deterministic org-scoped audit executions used by the product audit flow.

model AuditRun {
  id                     String         @id @default(cuid())
  organizationId         String
  periodKey              AuditPeriodKey
  periodStart            DateTime
  periodEnd              DateTime
  triggerSource          String         @default("manual")
  currency               String         @default("USD")
  status                 AuditRunStatus @default(PENDING)
  totalSpendUsd          Float          @default(0)
  estimatedWasteUsd      Float          @default(0)
  estimatedSavingsUsd    Float          @default(0)
  confidenceScore        Float          @default(0)
  sampleSize             Int            @default(0)
  highImpactFindingCount Int            @default(0)
  explanationVersion     String         @default("audit-rules-v1")
  statusReason           String?
  metadata               Json?
  createdAt              DateTime       @default(now())
  startedAt              DateTime?
  completedAt            DateTime?

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings        AuditFinding[]
  recommendations AuditRecommendation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, periodStart, periodEnd])
  @@map("audit_runs")
}

// ─── Internal Audit Finding ─────────────────────────────────────────────────
// Money-impacting findings derived from deterministic audit rules.

model AuditFinding {
  id                  String           @id @default(cuid())
  auditRunId          String
  organizationId      String
  type                AuditFindingType
  title               String
  description         String
  severity            String
  currentCostUsd      Float            @default(0)
  optimizedCostUsd    Float            @default(0)
  potentialSavingsUsd Float            @default(0)
  confidence          Float            @default(0)
  evidence            Json?
  createdAt           DateTime         @default(now())

  auditRun        AuditRun              @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations AuditRecommendation[]

  @@index([auditRunId])
  @@index([organizationId])
  @@index([type])
  @@index([potentialSavingsUsd])
  @@map("audit_findings")
}

// ─── Internal Audit Recommendation ──────────────────────────────────────────
// Actionable follow-up items that bridge findings to monetization.

model AuditRecommendation {
  id                   String      @id @default(cuid())
  auditRunId           String
  findingId            String?
  organizationId       String
  action               String
  estimatedSavingsUsd  Float       @default(0)
  implementationEffort AuditEffort
  autoFixAvailable     Boolean     @default(false)
  createdAt            DateTime    @default(now())

  auditRun     AuditRun      @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  finding      AuditFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([auditRunId])
  @@index([findingId])
  @@index([organizationId])
  @@map("audit_recommendations")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────
// Immutable event log for compliance + debugging.

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // "api_key.created" | "plan.upgraded" | "alert.triggered"
  resource       String // "api_key" | "plan" | "alert" | "org"
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Agent Recommendation Approval ───────────────────────────────────────────
// Durable human approval state for agent recommendations.

model AgentRecommendationApproval {
  id               String   @id @default(cuid())
  organizationId   String
  requestId        String
  recommendationId String
  agentType        String?
  decision         String
  reason           String?
  metadata         Json?
  submittedBy      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, requestId, recommendationId], name: "org_request_recommendation_unique")
  @@index([organizationId])
  @@index([requestId])
  @@index([recommendationId])
  @@index([decision])
  @@index([createdAt])
  @@map("agent_recommendation_approvals")
}

// ─── Demo Booking Engine ──────────────────────────────────────────────────────
// Autonomous demo scheduling triggered by audit completion, cost anomalies, or churn signals.
// Integrates with Calendly for availability and Zoom for conferencing.

enum DemoEngagementLevel {
  HIGH // > 70/100 readiness - full implementation focus
  MEDIUM // 50-70 readiness - exploratory demo
  LOW // 40-50 readiness - intro call
}

enum DemoClosingStrategy {
  FOUNDER_DEAL // $2000+ estimated savings - founder/executive pitch
  PILOT_PROGRAM // $500-2000 savings - structured 30-day pilot
  FREE_TRIAL // < $500 savings - freemium upgrade nudge
  EXPANSION_UPSELL // Existing customer - expand usage demo
  CHURN_RECOVERY // Re-engagement focused on ROI
}

enum DemoStatus {
  PENDING // Scheduled but not yet confirmed
  CONFIRMED // Lead accepted and confirmed attendance
  RESCHEDULED // Lead requested different time
  COMPLETED // Demo occurred (attendanceConfirmed=true)
  CANCELLED // Lead cancelled or no-show
  NO_SHOW // Demo time passed, lead did not attend
}

model DemoBooking {
  id                  String              @id @default(cuid())
  organizationId      String
  leadId              String
  auditId             String? // Audit that triggered this booking (if audit-path)
  demoDatetime        DateTime
  demoEndTime         DateTime
  timezone            String // e.g., "America/Los_Angeles"
  zoomLink            String? // Generated Zoom meeting URL
  zoomMeetingId       String? // Zoom meeting ID for API calls
  readinessScore      Int // 0-100 from engine
  engagementLevel     DemoEngagementLevel
  closingStrategy     DemoClosingStrategy
  estimatedSavingsUsd Float? // From audit or heuristic
  freshInsights       String? // What changed since prior audit (if re-booking)
  demoAgenda          String? // Generated agenda
  presidingNotes      String? // Sales prep: talking points + company intel
  closingTalk         String? // Strategy-specific closing script
  status              DemoStatus          @default(PENDING)
  attendanceConfirmed Boolean             @default(false)
  attendedAt          DateTime? // When demo actually occurred
  completionNotes     String? // Outcome: interested/not-ready/no-show/etc
  followUpId          String? // Reference to follow-up demo if scheduled
  metadata            Json? // Custom fields: calendly_slot_id, sentiment_score, etc
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  audit        AuditResult?    @relation(fields: [auditId], references: [id], onDelete: SetNull)
  recipients   DemoRecipient[] @relation("DemoToRecipients")

  @@unique([leadId, demoDatetime], name: "lead_demo_datetime_unique")
  @@index([organizationId])
  @@index([leadId])
  @@index([auditId])
  @@index([organizationId, demoDatetime])
  @@index([organizationId, status])
  @@index([organizationId, engagementLevel])
  @@index([organizationId, closingStrategy])
  @@index([demoDatetime, status])
  @@map("demo_bookings")
}

model DemoRecipient {
  id             String    @id @default(cuid())
  demoId         String
  organizationId String
  email          String
  name           String?
  role           String? // "decision_maker" | "technical_lead" | "finance"
  rsvp           String? // "ACCEPTED" | "DECLINED" | "TENTATIVE"
  rsvpedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  demo         DemoBooking  @relation("DemoToRecipients", fields: [demoId], references: [id], onDelete: Cascade)
  organization Organization @relation("DemoRecipientsOrg", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([demoId])
  @@index([organizationId])
  @@index([email])
  @@map("demo_recipients")
}

model LeadDemoPreference {
  id                 String    @id @default(cuid())
  organizationId     String
  leadId             String
  besttimeToCall     String? // "morning" | "afternoon" | "evening"
  preferredDayOfWeek String? // "monday" | "tuesday" | etc
  preferredTimezone  String?
  doNotContactAfter  DateTime?
  cancelledReasons   String[] // ["too_busy", "not_interested", "already_using"]
  cancellationCount  Int       @default(0)
  lastCancelledAt    DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([organizationId, leadId])
  @@index([organizationId, leadId])
  @@map("lead_demo_preferences")
}

// ─── Idempotency Key ──────────────────────────────────────────────────────────
// Ensures Stripe webhooks (and other events) are processed exactly once.

model IdempotencyKey {
  id           String           @id @default(cuid())
  key          String           @unique
  eventType    String?
  status       ProcessingStatus @default(PROCESSING)
  attemptCount Int              @default(1)
  lastError    String?
  processedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@map("idempotency_keys")
}

model StripeEvent {
  id            String           @id @default(cuid())
  stripeEventId String           @unique
  type          String
  status        ProcessingStatus @default(PROCESSING)
  attemptCount  Int              @default(1)
  payload       Json?
  lastError     String?
  processedAt   DateTime?
  claimedAt     DateTime?
  claimedBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([type, createdAt])
  @@index([status, updatedAt])
  @@map("stripe_events")
}

// ─── Dead Letter Queue ─────────────────────────────────────────────────────────
// Terminal job failures for manual review and scheduled auto-replay

model FailedJob {
  id             String    @id @default(cuid())
  jobType        String
  payload        Json
  errorClass     String // "transient" | "permanent" | "abort"
  fingerprint    String?
  errorMessage   String
  httpStatus     Int?
  retryCount     Int       @default(0)
  replayAttempts Int       @default(0) // Incremented each replay attempt (max 10)
  poisoned       Boolean   @default(false) // Marked after threshold or abort errors
  poisonReason   String?
  failedAt       DateTime  @default(now())
  retryAfter     DateTime?
  replayedAt     DateTime?
  replayedBy     String?

  @@index([errorClass, replayedAt, retryAfter])
  @@index([jobType, failedAt])
  @@index([poisoned])
  @@index([replayAttempts])
  @@index([fingerprint, failedAt])
  @@map("failed_jobs")
}

model ExternalEffect {
  id               String               @id @default(cuid())
  organizationId   String
  runId            String?
  workflowRunId    String?
  effectType       String
  idempotencyKey   String
  status           ExternalEffectStatus @default(PENDING)
  attemptCount     Int                  @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  claimToken       String?
  claimedAt        DateTime?
  completedAt      DateTime?
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, effectType, idempotencyKey], name: "org_effect_idempotency_unique")
  @@index([organizationId, status, createdAt])
  @@index([runId])
  @@index([workflowRunId])
  @@map("external_effects")
}

model OutboxEvent {
  id               String            @id @default(cuid())
  organizationId   String?
  aggregateType    String
  aggregateId      String
  eventType        String
  payload          Json
  status           OutboxEventStatus @default(PENDING)
  attemptCount     Int               @default(0)
  nextAttemptAt    DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  fingerprint      String?
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, createdAt])
  @@index([organizationId, eventType, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([fingerprint])
  @@map("outbox_events")
}

// ─── Organization Entitlements ────────────────────────────────────────────────
// Tracks gating, paywalls, and feature unlocks

model OrgEntitlement {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  auditUnlockedAt      DateTime?
  plan                 String    @default("free")
  trialStartedAt       DateTime?
  trialExpiresAt       DateTime?
  proTrialUsed         Boolean   @default(false)
  secureComputeEnabled Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_entitlements")
}

// ─── Affiliate Engine ─────────────────────────────────────────────────────────

enum PartnerStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  BANNED
  REVIEW_REQUIRED
}

enum CommissionStatus {
  PENDING
  APPROVED
  AVAILABLE
  PAID
  CANCELLED
  REVERSED
}

model Partner {
  id                     String        @id @default(cuid())
  userId                 String        @unique
  referralCode           String        @unique
  stripeConnectAccountId String?
  status                 PartnerStatus @default(ACTIVE)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals     Referral[]
  commissions   Commission[]
  wallets       PartnerWallet[]
  payoutBatches PayoutBatch[]

  @@map("partners")
}

model Referral {
  id                String   @id @default(cuid())
  partnerId         String
  referredUserId    String   @unique
  status            String   @default("PENDING")
  ipAddress         String?
  deviceFingerprint String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  partner      Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referredUser User    @relation(fields: [referredUserId], references: [id], onDelete: Cascade)

  conversionEvents ConversionEvent[]
  commissions      Commission[]
  ledgerEntries    WalletLedgerEntry[]

  @@index([partnerId])
  @@map("referrals")
}

// ═══════════════════════════════════════════════════════════════════════════════
// GTM — Autonomous Revenue Machine
// ═══════════════════════════════════════════════════════════════════════════════

enum DealStage {
  PROSPECTING
  CONTACTED
  ENGAGED
  QUALIFIED
  DEMOED
  PROPOSAL_SENT
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
  ONBOARDED
  EXPANDED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  KILLED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN_DM
  TWITTER_DM
  SLACK_CONNECT
  PAYMENT_LINK
}

enum OutreachStatus {
  QUEUED
  SENT
  OPENED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

// ─── Deal ──────────────────────────────────────────────────────────────────────
// Formal deal record, created when a lead is promoted to QUALIFIED+.
// Owns the lifecycle from first contact to Closed/Expanded.

model Deal {
  id                 String    @id @default(cuid())
  organizationId     String
  leadId             String?
  companyName        String
  contactName        String?
  contactEmail       String?
  stage              DealStage @default(PROSPECTING)
  valueUsd           Float?
  currency           String    @default("USD")
  planTier           String?
  paymentTermDays    Int       @default(0)
  discountPct        Float     @default(0)
  campaignId         String?
  assignedAgentTypes String[]
  stageHistory       Json      @default("[]")
  nextFollowUpAt     DateTime?
  closedAt           DateTime?
  wonAt              DateTime?
  lostReason         String?
  notes              String?
  stripeCheckoutUrl  String?
  stripeSessionId    String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  outreachLogs OutreachLog[]
  proposals    Proposal[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([campaignId])
  @@index([createdAt])
  @@map("deals")
}

// ─── OutreachLog ───────────────────────────────────────────────────────────────
// Every message sent to a prospect — email, LinkedIn DM, Slack, etc.

model OutreachLog {
  id             String          @id @default(cuid())
  organizationId String
  dealId         String?
  channel        OutreachChannel
  status         OutreachStatus  @default(QUEUED)
  toEmail        String?
  toLinkedIn     String?
  subject        String?
  bodyText       String
  templateKey    String?
  sentAt         DateTime?
  openedAt       DateTime?
  repliedAt      String?
  bounceReason   String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([dealId])
  @@index([channel, status])
  @@index([sentAt])
  @@map("outreach_logs")
}

// ─── Proposal ─────────────────────────────────────────────────────────────────
// Pricing proposal/quote for a deal. Versioned — one deal can have many.

model Proposal {
  id              String         @id @default(cuid())
  organizationId  String
  dealId          String
  version         Int            @default(1)
  status          ProposalStatus @default(DRAFT)
  planTier        String
  valueUsd        Float
  discountPct     Float          @default(0)
  paymentTermDays Int            @default(0)
  validUntil      DateTime?
  lineItems       Json           @default("[]")
  terms           String?
  sentAt          DateTime?
  viewedAt        DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectedReason  String?
  signatureUrl    String?
  paymentLinkUrl  String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dealId])
  @@index([status])
  @@index([createdAt])
  @@map("proposals")
}

// ─── Campaign ─────────────────────────────────────────────────────────────────
// An autonomous GTM campaign (e.g. "72-hour Founding Sprint").
// Owns budget, KPIs, policy, and kill-switch state.

model Campaign {
  id               String         @id @default(cuid())
  organizationId   String
  name             String
  status           CampaignStatus @default(DRAFT)
  targetRevenueUsd Float
  budgetUsd        Float
  spentUsd         Float          @default(0)
  durationHours    Int            @default(72)
  startAt          DateTime?
  endAt            DateTime?
  targetIcpJson    Json?
  policyJson       Json?
  kpiSnapshot      Json?
  killSwitchLevel  Int            @default(0)
  killSwitchReason String?
  killSwitchAt     DateTime?
  deals            Deal[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([startAt])
  @@map("campaigns")
}

model ConversionEvent {
  id         String   @id @default(cuid())
  referralId String
  eventType  String // e.g. "SIGNUP", "PAYMENT"
  amount     Float?
  currency   String?  @default("USD")
  metadata   Json?
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([eventType])
  @@map("conversion_events")
}

model MarketingAsset {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("marketing_assets")
}

model Commission {
  id          String           @id @default(cuid())
  partnerId   String
  referralId  String?
  amount      Float
  currency    String           @default("USD")
  status      CommissionStatus @default(PENDING)
  availableAt DateTime?
  paidAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  partner       Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referral      Referral?           @relation(fields: [referralId], references: [id], onDelete: SetNull)
  payoutItems   PayoutItem[]
  ledgerEntries WalletLedgerEntry[]

  @@index([partnerId])
  @@index([status])
  @@index([status, createdAt, partnerId])
  @@map("commissions")
}

enum WalletLedgerAccount {
  PARTNER_AVAILABLE
  PLATFORM_PAYABLE
}

enum WalletLedgerDirection {
  CREDIT
  DEBIT
}

enum PayoutBatchStatus {
  PROCESSING
  SUCCEEDED
  PARTIAL
  FAILED
}

model PartnerWallet {
  id               String   @id @default(cuid())
  partnerId        String
  currency         String
  availableBalance Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partner       Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  ledgerEntries WalletLedgerEntry[]

  @@unique([partnerId, currency])
  @@index([partnerId])
  @@map("partner_wallets")
}

model WalletLedgerEntry {
  id             String                @id @default(cuid())
  entryGroupId   String
  partnerId      String
  walletId       String?
  payoutBatchId  String?
  referralId     String?
  commissionId   String?
  currency       String
  account        WalletLedgerAccount
  direction      WalletLedgerDirection
  entryType      String
  amount         Float
  balanceAfter   Float?
  idempotencyKey String
  metadata       Json?
  hashScope      String
  chainIndex     Int
  prevEntryHash  String?
  entryHash      String
  createdAt      DateTime              @default(now())

  wallet      PartnerWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  payoutBatch PayoutBatch?   @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  referral    Referral?      @relation(fields: [referralId], references: [id], onDelete: SetNull)
  commission  Commission?    @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@unique([walletId, idempotencyKey])
  @@index([partnerId, currency])
  @@index([hashScope, chainIndex])
  @@index([walletId])
  @@map("wallet_ledger_entries")
}

model PayoutBatch {
  id               String            @id @default(cuid())
  partnerId        String
  currency         String
  totalAmount      Float
  commissionCount  Int               @default(0)
  status           PayoutBatchStatus @default(PROCESSING)
  idempotencyKey   String            @unique
  stripeTransferId String?
  stripeFeeAmount  Float?
  stripeNetAmount  Float?
  failureReason    String?
  retryCount       Int               @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  reconciledAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  partner       Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  items         PayoutItem[]
  ledgerEntries WalletLedgerEntry[]

  @@index([partnerId, status, createdAt])
  @@index([stripeTransferId])
  @@map("payout_batches")
}

model PayoutItem {
  id            String   @id @default(cuid())
  payoutBatchId String
  commissionId  String
  amount        Float
  createdAt     DateTime @default(now())

  payoutBatch PayoutBatch @relation(fields: [payoutBatchId], references: [id], onDelete: Cascade)
  commission  Commission  @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@unique([payoutBatchId, commissionId])
  @@index([commissionId])
  @@map("payout_items")
}

// ─── Event Sourcing & World Model ─────────────────────────────────────────────

model SystemEvent {
  id        String   @id @default(cuid())
  sequence  BigInt   @unique @default(autoincrement())
  orgId     String?
  type      String
  payload   Json
  createdAt DateTime @default(now())
  causedBy  String?

  // We could add relation to Organization, but usually EventStore is kept
  // slightly decoupled. Let's add it for strict referential integrity.
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, sequence(sort: Desc)])
  @@index([type])
  @@map("system_events")
}

model EventStreamCheckpoint {
  id        String   @id @default(cuid())
  consumer  String   @unique
  sequence  BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("event_stream_checkpoints")
}

model WorldSnapshot {
  id            String   @id @default(cuid())
  orgId         String   @unique
  snapshotJson  Json
  eventSequence BigInt   @default(0)
  builtAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("world_snapshots")
}

model EvolutionMutation {
  id             String    @id @default(cuid())
  orgId          String
  type           String
  target         String
  proposedChange Json
  hypothesis     String
  simScore       Float
  deployed       Boolean   @default(false)
  deployedAt     DateTime?
  rolledBack     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("evolution_mutations")
}

// ─── Engineering Economy Layer ────────────────────────────────────────────────

model EngineeringWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions EngineeringTransaction[]

  @@map("engineering_wallets")
}

model EngineeringTransaction {
  id          String   @id @default(cuid())
  walletId    String
  amount      Int // Negative for PR cost, positive for stipend/rewards
  description String
  reason      String // PR_MERGE, STIPEND, DEBT_SETTLED, etc.
  prNumber    Int?
  commitSha   String?
  createdAt   DateTime @default(now())

  wallet EngineeringWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@map("engineering_transactions")
}

model EngineeringDebt {
  id               String   @id @default(cuid())
  userId           String // The dev who owns the debt
  issueNumber      Int // GitHub issue / PR number
  modulePath       String // e.g. packages/billing
  basePenalty      Int      @default(50)
  autoCompoundRate Float    @default(0.10) // 10% increase per cycle
  currentPenalty   Int      @default(50)
  status           String   @default("OPEN") // OPEN, RESOLVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("engineering_debts")
}

// ─── Agent Event Ledger ───────────────────────────────────────────────────────

model AgentEvent {
  id               String   @id
  agentId          String
  scope            String
  inputReference   String?
  outputReference  String?
  actionType       String
  riskLevel        String   @default("low")
  approvalRequired Boolean  @default(false)
  approvedBy       String?
  status           String   @default("drafted")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
  @@map("agent_events")
}

model SalesLead {
  id              String    @id @default(cuid())
  companyName     String    @unique
  website         String?
  country         String?
  segment         String?
  tier            String    @default("B")
  fitScore        String    @default("Medium")
  contactName     String?
  contactEmail    String?
  contactRole     String?
  contactRoute    String?
  linkedinUrl     String?
  painAngle       String?
  firstMessage    String?
  followUpMessage String?
  status          String    @default("New")
  channel         String?
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  repliedAt       DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([tier])
  @@index([country])
  @@index([nextFollowUpAt])
  @@map("sales_leads")
}
