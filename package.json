{
  "name": "@aiprofithub/sdk",
  "version": "0.1.0",
  "description": "JavaScript SDK for tracking AI API usage, cost, model spend, and feature-level attribution with AIProfitHub.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": ["ai", "llm", "ai-cost", "finops", "usage-tracking", "ai-observability"],
  "author": "AIProfitHub",
  "license": "MIT",
  "homepage": "https://aiprofithub.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiprofithub/aiprofithub-js.git"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
